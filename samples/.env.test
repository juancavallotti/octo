# The environment the sample suites run under: `dolphin test --env-file samples/.env.test`.
#
# A config's env is resolved when it is LOADED, before any block runs — so a flow whose
# connector reads ${ANTHROPIC_API_KEY} cannot even be BUILT without one, and mocking the
# block that would use it does not help. These are what let the samples be tested at all.
#
# Every value here is FAKE, and must stay fake. Nothing in a suite reaches the service
# these would authenticate against: the blocks that would call out are mocked, so the key
# is never used for anything but satisfying the config loader. That is exactly why this
# file can be committed — and why a real key must never be pasted into it.
#
# A suite that needs a different value for one variable says so in its own `env:` block,
# which overrides this file.

# --- LLM connectors: the api-key setting on llm-anthropic / llm-openai / llm-gemini ---
ANTHROPIC_API_KEY=test-anthropic-key
OPENAI_API_KEY=test-openai-key
GEMINI_API_KEY=test-gemini-key

# --- Notion ---
NOTION_TOKEN=test-notion-token
NOTION_VERIFICATION_TOKEN=test-verification-token
NOTION_DATABASE_ID=00000000-0000-0000-0000-000000000000

# --- Pinecone (rag-pipeline) ---
# PINECONE_HOST is what keeps the connector off the network at startup: given the
# index's host it addresses the index directly instead of looking it up, so no
# case here reaches api.pinecone.io just to build the flow. Nothing is ever SENT
# to this host either — every pinecone block in the suites is mocked, or pointed
# at a refused port on purpose.
PINECONE_API_KEY=test-pinecone-key
PINECONE_INDEX=test-index
PINECONE_HOST=test-index.svc.test.pinecone.io

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-test-token
SLACK_SIGNING_SECRET=test-signing-secret

# --- The OAuth-protected resource (jwt-validate) ---
OIDC_AUDIENCE=test-audience

# --- An http-client's OAuth2 client credentials (runtime-services) ---
API_CLIENT_ID=test-client-id
API_CLIENT_SECRET=test-client-secret

# --- resources-demo substitutes this into a set-payload ---
GREETING=hello
