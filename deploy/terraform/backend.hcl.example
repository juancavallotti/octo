# Backend configuration shared by every root. Copy to backend.hcl (gitignored) and
# set your bucket, then pass it at init time:
#
#   terraform -chdir=infra init -backend-config=../backend.hcl
#
# (The `task` targets do this for you.)
#
# Why partial config: a backend block cannot reference variables, so the bucket
# would otherwise be a literal baked into five files that every fork has to edit.
# The prefix stays in each root's backend.tf — it identifies the root, not the
# environment, and must never be accidentally shared between two roots.
#
# Create the bucket once with `task state:bucket PROJECT=<your-project>`.
bucket = "octo-tfstate-your-project"
