# Variables for the `eks` root. Copy to terraform.tfvars (gitignored) and fill in.
# Terraform loads that filename automatically — no -var-file flag.
#
# Two prerequisites, both one time:
#   1. The Route53 hosted zone below must exist and be delegated from whoever holds
#      the parent domain. This root creates RECORDS in it, never the zone itself —
#      see ../README.md.
#   2. The S3 state bucket: `task eks:state:bucket BUCKET=<name>`, then copy
#      ../backend-aws.hcl.example to ../backend-aws.hcl and set it there.
#
# COST: the EKS control plane is ~$0.10/hour (~$73/month) with no free tier, billed
# from the moment the cluster exists — and $0.60/hour if kubernetes_version has
# fallen out of standard support. Destroy the root when you are done.

# --- Hostnames ---
# domain must be a SUBDOMAIN, not the zone apex: the record pointing at the ALB is
# a CNAME, and a CNAME at an apex is not legal.
route53_zone_name = "aws.octopaas.dev"
domain            = "octo.aws.octopaas.dev"
apps_domain       = "aws.octopaas.dev" # {slug}.{apps_domain}; covered by the same ACM cert

# --- Region ---
# region = "us-east-1"

# --- Chart + images ---
# chart_source  = "local"
# chart_version = "0.6.4"
#
# To test the current working tree rather than the published images:
#
#   task images:ttl TTL=12h
#   task eks:apply IMAGE_VALUES=dist/values.ttl.yaml
#
# image_values_file = ""

# --- Database ---
# false runs the chart's bundled Postgres StatefulSet on a gp3 EBS volume.
# true provisions RDS in the private subnets and points the chart at it via a
# Secret. This single flip is what makes both database paths testable.
# external_database  = false
# rds_instance_class = "db.t4g.micro"

# --- Editor sign-in ---
# Off by default, which means the editor is reachable by anyone who can resolve the
# hostname above. Register https://{domain}/api/auth/callback/eetr as the redirect
# URI with the IdP before turning this on, or the sign-in round trip fails at the
# callback.
#
# The Auth.js session secret and the KV secret-namespace encryption key are NOT set
# here — Terraform mints both per cluster and holds them in state, so secret KV
# namespaces work on a fresh cluster with nothing to configure.
# oidc_enabled       = true
# oidc_client_id     = "eetr_xxxxxxxxxxxxxxxxxxxxxxxx"
# oidc_client_secret = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# oidc_issuer        = "https://auth.eetr.app" # default
# oidc_write_roles   = ""                      # e.g. "admin,operator"; empty = any signed-in user
# oidc_roles_claim   = ""                      # override if the IdP uses a non-"roles" claim

# --- Cost / production toggles (defaults are the cheap, disposable choices) ---
# node_instance_types = ["t3.large"]  # t3.medium is too tight with the bundled DB
# node_desired_size   = 2
# node_min_size       = 1
# node_max_size       = 3
# spot_nodes          = true   # reclaimable at two minutes' notice
# private_nodes       = false  # true adds a NAT gateway (~$32/mo + data processing)
# kubernetes_version  = "1.35"  # MUST be a standard-support version: extended
#                               # support is $0.60/hour, not $0.10
# vpc_cidr            = "10.70.0.0/16"
#
# How long to wait after the release before reading the Ingress for the ALB's
# hostname. If the apply fails with an empty hostname, raise this — do not remove
# the wait; the controller simply has not finished provisioning the ALB yet.
# alb_wait = "120s"

# tags = { owner = "you", environment = "test" }
