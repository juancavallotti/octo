# Variables for the `eks` root. Copy to terraform.tfvars (gitignored) and fill in.
# Terraform loads that filename automatically — no -var-file flag.
#
# Two prerequisites, both one time:
#   1. The Route53 hosted zone below must exist and be delegated from whoever holds
#      the parent domain. This root creates RECORDS in it, never the zone itself —
#      see ../README.md.
#   2. The S3 state bucket: `task eks:state:bucket BUCKET=<name>`, then copy
#      ../backend-aws.hcl.example to ../backend-aws.hcl and set it there.
#
# COST: the EKS control plane is ~$0.10/hour (~$73/month) with no free tier, billed
# from the moment the cluster exists — and $0.60/hour if kubernetes_version has
# fallen out of standard support. Destroy the root when you are done.

# --- Hostnames ---
# domain must be a SUBDOMAIN, not the zone apex: the record pointing at the ALB is
# a CNAME, and a CNAME at an apex is not legal.
#
# Both hostnames must also sit INSIDE route53_zone_name, and the zone's name must
# be the name delegated to it. AWS's nameservers are shared across every customer
# and match by zone name, so delegating eks.octopaas.dev at nameservers that host
# a zone named something else answers REFUSED — the NS values looking right is not
# evidence the delegation works. Check with `dig NS <zone> @<one of its NS>` and
# expect NOERROR.
route53_zone_name = "eks.octopaas.dev"
domain            = "octo.eks.octopaas.dev"
apps_domain       = "eks.octopaas.dev" # {slug}.{apps_domain}; covered by the same ACM cert

# --- Region ---
# region = "us-east-1"

# --- Chart + images ---
# chart_source  = "local"
# chart_version = "0.8.7"  # REQUIRED when chart_source = "oci";
#                          # must match helm/Chart.yaml at that release
#
# To test the current working tree rather than the published images:
#
#   task images:ttl TTL=12h
#   task eks:apply IMAGE_VALUES=dist/values.ttl.yaml
#
# image_values_file = ""

# --- Database ---
# false runs the chart's bundled Postgres StatefulSet on a gp3 EBS volume.
# true provisions RDS in the private subnets and points the chart at it via a
# Secret. This single flip is what makes both database paths testable.
# external_database  = false
# rds_instance_class = "db.t4g.micro"

# --- Editor sign-in ---
# Off by default, which means the editor is reachable by anyone who can resolve the
# hostname above. Register https://{domain}/api/auth/callback/oidc as the redirect
# URI with the IdP before turning this on, or the sign-in round trip fails at the
# callback.
#
# The Auth.js session secret and the KV secret-namespace encryption key are NOT set
# here — Terraform mints both per cluster and holds them in state, so secret KV
# namespaces work on a fresh cluster with nothing to configure.
# oidc_enabled       = true
# oidc_client_id     = "xxxxxxxxxxxxxxxxxxxxxxxx"
# oidc_client_secret = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# oidc_issuer        = "https://idp.example.com" # your OIDC provider
# oidc_provider_name = "Keycloak"                # sign-in button label; empty = "OIDC"
# oidc_write_roles   = ""                        # e.g. "admin,operator"; empty = any signed-in user
# oidc_roles_claim   = ""                        # override if the IdP uses a non-"roles" claim

# --- Cost / production toggles (defaults are the cheap, disposable choices) ---
# node_instance_types = ["t3.large"]  # t3.medium is too tight with the bundled DB
# node_desired_size   = 2
# node_min_size       = 1
# node_max_size       = 3
# spot_nodes          = true   # reclaimable at two minutes' notice
# private_nodes       = false  # true adds a NAT gateway (~$32/mo + data processing)
# kubernetes_version  = "1.35"  # MUST be a standard-support version: extended
#                               # support is $0.60/hour, not $0.10
# vpc_cidr            = "10.70.0.0/16"
#
# How long to wait after the release before reading the Ingress for the ALB's
# hostname. If the apply fails with an empty hostname, raise this — do not remove
# the wait; the controller simply has not finished provisioning the ALB yet.
# alb_wait = "120s"

# tags = { owner = "you", environment = "test" }

# --- Naming and placement (defaults shown) ---
# name      = "octo-eks"      # cluster name; also prefixes the derived resources
# namespace = "octo"          # Kubernetes namespace the release installs into
#
# How long Terraform waits for the Helm release to become ready, in seconds. The
# first apply pulls every image onto fresh nodes, which is the slow one.
# helm_timeout = 900
#
# How long a scheduled-for-deletion KMS key (the one encrypting cluster secrets)
# stays recoverable. AWS allows 7-30; 7 is the shortest and suits a disposable
# test cluster, longer suits anything holding data you would miss.
# kms_key_deletion_window_in_days = 7

# --- Embeddings (optional) ---
# Deploy the embedding server and searching agent memory ranks by MEANING rather
# than by words. Leave it out and search still works — it matches text, which is a
# supported way to run rather than a degraded one.
#
# The server is a small octo app that holds the provider API key, so that no
# integration pod has to. Every deployment pod is given only its URL, which is safe
# to hand out: an embedding reads nothing, writes nothing, and grants access to
# nothing more expensive than itself.
#
# CHANGING THE MODEL LATER IS NOT A SETTING CHANGE. Vectors carry no record of
# which model produced them, so a store holding two models' cannot be ranked
# coherently. Changing embeddings_model on an installation that has embedded
# anything discards every stored vector and re-embeds the store. Search falls back
# to matching text while that runs; nothing is lost but the vectors.
# embeddings_enabled        = false          # true also requires embeddings_api_key
# embeddings_api_key        = ""             # "sk-..."
# embeddings_connector_type = "llm-openai"   # or llm-gemini, llm-openrouter. NOT
#                                            # llm-anthropic: no embeddings API, and
#                                            # the server refuses to start rather
#                                            # than failing on the first call.
# embeddings_model          = "text-embedding-3-small"
# embeddings_dimensions     = 1536           # must match the vector(N) columns in
#                                            # sql/schema.sql, which are indexed and
#                                            # so fixed at schema time
