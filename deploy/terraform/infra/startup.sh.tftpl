#!/usr/bin/env bash
# First-boot bootstrap for the octo single-node k3s VM. It brings up the cluster
# and its prerequisites only — the octo chart itself is installed/upgraded by the
# Terraform Helm release (deploy/terraform/release), applied after images are
# published. Rendered by Terraform (templatefile): registry_host, domain and
# acme_email are substituted; plain $VAR tokens are shell. (No `set -x`: the
# metadata token must not reach the serial console.)
set -euo pipefail

# Refresh the octo-pull helper from its (Terraform-managed) metadata on EVERY boot,
# before the first-boot guard below — so changes to the helper (e.g. an image
# rename) propagate to an already-provisioned VM on reboot instead of going stale.
# Guarded on curl (preinstalled on the base image; the first-boot path below also
# (re)installs it after apt) and `|| true` so it can never fail the bootstrap.
if command -v curl >/dev/null 2>&1; then
  curl -s -H "Metadata-Flavor: Google" \
    "http://metadata.google.internal/computeMetadata/v1/instance/attributes/octo-pull-sh" \
    > /usr/local/bin/octo-pull 2>/dev/null && chmod +x /usr/local/bin/octo-pull || true
fi

# --- Data disk ---
# The attached persistent disk that holds the database (modules/base). Prepared on
# EVERY boot, before the first-boot guard below, so an already-provisioned VM picks
# up a newly attached — or newly resized — disk on reboot instead of needing a
# re-bootstrap. util-linux and e2fsprogs ship on the Debian 12 image, so this runs
# safely ahead of apt.
#
# No partition table: the filesystem owns the whole device. That is what makes a
# Terraform-side resize a single resize2fs, with no growpart/sfdisk step that can
# leave a half-grown partition behind.
DATA_DEV="/dev/disk/by-id/google-${data_disk_device_name}"
DATA_MNT="${data_disk_mount_path}"
if [ -b "$DATA_DEV" ]; then
  if ! blkid "$DATA_DEV" >/dev/null 2>&1; then
    mkfs.ext4 -m 0 -E lazy_itable_init=0,lazy_journal_init=0,discard "$DATA_DEV"
  fi
  mkdir -p "$DATA_MNT"
  DATA_UUID="$(blkid -s UUID -o value "$DATA_DEV")"
  # By UUID rather than device path, and nofail so a detached disk degrades to a
  # missing mount instead of dropping the box into emergency mode on boot.
  if ! grep -q "^UUID=$DATA_UUID " /etc/fstab; then
    echo "UUID=$DATA_UUID $DATA_MNT ext4 discard,defaults,nofail 0 2" >> /etc/fstab
    systemctl daemon-reload || true
  fi
  mountpoint -q "$DATA_MNT" || mount "$DATA_MNT" || true
  # Picks up a Terraform-side size increase; a no-op when already at size.
  if mountpoint -q "$DATA_MNT"; then
    resize2fs "$DATA_DEV" || true
    # postgres_host_path points at this subdirectory, not the mount root. Created
    # ONLY on a successful mount: the release root asks for hostPathType=Directory,
    # so its absence is what stops Postgres from initialising on the boot disk.
    mkdir -p "$DATA_MNT/postgres"
  else
    echo "ERROR: $DATA_DEV did not mount at $DATA_MNT; the database has nowhere durable to live. Postgres will stay Pending until this is fixed." >&2
  fi
else
  echo "ERROR: $DATA_DEV is not attached; the database has nowhere durable to live. Postgres will stay Pending until this is fixed." >&2
fi

# GCE re-runs startup scripts on every boot; k3s's systemd service keeps the
# cluster alive across reboots, so skip re-bootstrapping once it has succeeded.
if [ -f /opt/octo/.provisioned ]; then
  echo "already provisioned; octo-pull refreshed, data disk checked; nothing else to do"
  exit 0
fi

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y jq curl ca-certificates

mkdir -p /opt/octo /etc/rancher/k3s

# A registry access token for the boot-time image pulls; the release root later
# refreshes this per deploy via the octo-pull helper.
TOKEN=$(curl -s -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
  | jq -r .access_token)

# Containerd auth for Artifact Registry (k3s reads this once at startup). Used as
# a fallback during the boot window; steady-state pulls go through octo-pull.
cat > /etc/rancher/k3s/registries.yaml <<EOF
configs:
  "${registry_host}":
    auth:
      username: oauth2accesstoken
      password: "$TOKEN"
EOF

# --- Install k3s (Traefik + servicelb; Traefik serves 80/443). --tls-san adds
# the domain to the API server cert so the Terraform Helm provider can reach
# https://${domain}:6443 with a valid certificate. ---
if ! command -v k3s >/dev/null 2>&1; then
  curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="--write-kubeconfig-mode 644 --tls-san ${domain}" sh -
fi
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
export PATH=$PATH:/usr/local/bin

until kubectl get nodes 2>/dev/null | grep -q ' Ready'; do
  echo "waiting for k3s node..."
  sleep 5
done

# --- Install the octo-pull helper (delivered via metadata) the release root
# calls over SSH to pull images with a fresh token before each helm apply. ---
curl -s -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/instance/attributes/octo-pull-sh" \
  > /usr/local/bin/octo-pull
chmod +x /usr/local/bin/octo-pull

# --- Install the Helm CLI (handy for debugging; the release is driven by the
# Terraform Helm provider, not this binary). ---
if ! command -v helm >/dev/null 2>&1; then
  curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash
fi

# --- cert-manager (CRDs + controllers) ---
# --cluster-issuer-ambient-credentials lets the DNS-01 ClusterIssuer below solve
# Cloud DNS challenges with the VM's service account (via the metadata server)
# instead of a mounted key Secret.
helm repo add jetstack https://charts.jetstack.io
helm repo update
helm upgrade --install cert-manager jetstack/cert-manager \
  --namespace cert-manager --create-namespace \
  --set crds.enabled=true \
  --set "extraArgs={--cluster-issuer-ambient-credentials=true}" \
  --wait --timeout 5m

# --- Let's Encrypt ClusterIssuers ---
# letsencrypt-prod: HTTP-01 via Traefik, for the apex host and any per-host certs.
# letsencrypt-dns:  DNS-01 via Cloud DNS (ambient creds), the only ACME method
#                   that can issue the *.{domain} wildcard cert.
cat > /opt/octo/clusterissuer.yaml <<EOF
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-prod
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: ${acme_email}
    privateKeySecretRef:
      name: letsencrypt-prod-account-key
    solvers:
      - http01:
          ingress:
            ingressClassName: traefik
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-dns
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: ${acme_email}
    privateKeySecretRef:
      name: letsencrypt-dns-account-key
    solvers:
      - dns01:
          cloudDNS:
            project: ${project_id}
EOF
# Retry: the cert-manager webhook may need a moment after --wait.
for i in $(seq 1 12); do
  kubectl apply -f /opt/octo/clusterissuer.yaml && break
  echo "waiting for cert-manager webhook... ($i)"
  sleep 10
done

touch /opt/octo/.provisioned
echo "bootstrap complete; apply deploy/terraform/release to install octo"
