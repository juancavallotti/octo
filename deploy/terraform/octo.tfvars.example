# The one tfvars file. Copy to octo.tfvars (gitignored) and fill it in; both the
# infra and release roots read it with -var-file=../octo.tfvars (the `task` targets
# pass that for you). image_tag / chart_version are per-deploy and come from the
# command line (`task deploy TAG=...`), so they are not here.

# --- Required ---
project_id       = "your-gcp-project-id"
domain           = "octo.juancavallotti.com" # editor host; subdomains live under *.{apps_domain} (below)
dns_managed_zone = "your-clouddns-zone-name"  # Cloud DNS zone NAME backing apps_domain (or domain, if apps_domain is unset)

# --- Optional: split domains ---
# Per-integration subdomains (and the wildcard cert) can live under a different
# domain than the editor itself — useful when `domain`'s registrar won't let you
# delegate the whole zone to Cloud DNS (e.g. Cloudflare Registrar) but a subdomain
# of it can still be NS-delegated. Leave unset for the original single-domain
# behavior (everything lives under `domain`, which must then be Cloud-DNS-managed
# itself). When set, dns_managed_zone above must back apps_domain, not domain.
# apps_domain = "apps.octo.juancavallotti.com"

# --- Cloud Build (optional) ---
# Connect the GitHub repo to Cloud Build once (console: Cloud Build -> Triggers ->
# Connect repository), then set this true and re-apply infra. On a version tag the
# build then publishes AND rolls the cluster.
# enable_cloudbuild = true

# --- SSO / OIDC (optional) ---
# Gate the editor behind eetr single sign-on (consumed by the release root). The
# client secret is kept in the release Terraform state (the GCS bucket), and the
# Auth.js session secret is generated automatically — no Secret Manager. Register the
# redirect URI https://{domain}/api/auth/callback/eetr on the IdP.
# A local `task deploy` also seeds these into release/oidc.json in the state bucket so
# the Cloud Build deploy step (which never sees this gitignored file) reads them back;
# re-run `task deploy` once after changing any oidc_* value.
# oidc_enabled       = true
# oidc_client_id     = "eetr_xxxxxxxxxxxxxxxxxxxxxxxx"
# oidc_client_secret = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# oidc_issuer        = "https://auth.eetr.app" # default
# oidc_write_roles   = ""                       # e.g. "admin,operator" to gate writes; empty = any signed-in user
# oidc_roles_claim   = ""                       # override if the IdP uses a non-"roles" claim

# --- Optional overrides (defaults shown) ---
# region        = "us-west1"
# zone          = "us-west1-a"
# instance_name = "octo"
# repository_id = "octo"
# cluster_issuer = "letsencrypt-prod"
# wildcard_tls   = true # one *.{apps_domain} cert via DNS-01 (or *.{domain} when
#                       # apps_domain is unset), shared by all subdomains
#                       # (set false to fall back to per-host HTTP-01 certs)
#
# Infra-only knobs (uncommenting these is fine; a `terraform apply` on the release
# root may print a harmless "undeclared variable" note for them — the `task` targets
# pass -compact-warnings):
# machine_type           = "e2-standard-2"
# acme_email             = "you@example.com"
# boot_disk_size_gb      = 30
# ssh_source_ranges      = ["203.0.113.4/32"] # keep 35.235.240.0/20 for IAP/Cloud Build
# kube_api_source_ranges = ["203.0.113.4/32"]
