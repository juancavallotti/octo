bin/
dist/
# Postgres data dir for the local k3d dev cluster, host-mounted into the node
# (see deploy/k3d/cluster.yaml). Keep the dir (data/.gitkeep) but never its data.
/data/*
!/data/.gitkeep
# Rendered runtime configs the editor writes for `octo -watch` (dev RUN feature).
/.octo-run/
# Local flow YAML the standalone app reads/writes under `task dev`.
/.octo-flows/
# Go build output left in a module dir by `go build` without -o (binary named
# after the package dir, e.g. runtime/octo/octo). The canonical output is bin/.
/runtime/octo/octo
/runtime/dolphin/dolphin
/orchestrator/orchestrator
/sidecars/dev/dev
# DevSpace's local state/cache dir.
/.devspace/
# What the file-io sample writes into its own workspace when it runs. The input
# it reads (workspace/service.yaml) is committed; its output is not.
/samples/file-io/workspace/out/
*.log
*.tmp
*.swp
.DS_Store
__debug_bin*
*.go.test
node_modules
*.tsbuildinfo

# Generated by `helm dependency build` (DevSpace runs it on deploy). octo-common
# is vendored under helm/charts/, so the lock records nothing that isn't already
# in the tree — and nothing bumps its version, so it would only ever go stale.
helm/Chart.lock

# The standalone object store. `octo run` serializes its persistent namespaces
# here (see --storage-dir / OCTO_STORAGE_DIR), so running a sample from the repo
# root leaves one behind. It is a runtime artifact, not source.
octo-store/
