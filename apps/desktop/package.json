{
  "name": "desktop",
  "productName": "Octo",
  "version": "0.11.2",
  "private": true,
  "description": "Octo Desktop — the standalone editor as a native app with a working folder",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --run",
    "start": "electron .",
    "dist": "electron-builder",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.preload.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
